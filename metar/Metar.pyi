class ParserError(Exception): ...

class Conditions:
    wind_dir: Optional[direction]
    wind_speed: Optional[speed]
    wind_gust: Optional[speed]
    wind_dir_from: Optional[direction]
    wind_dir_to: Optional[direction]
    vis: Optional[distance]
    vis_dir: Optional[direction]
    max_vis: Optional[distance]
    max_vis_dir: Optional[direction]
    weather: List[Tuple[str, str, str, str, str]]
    sky: List[Tuple[str, Optional[distance], str]]
    cavok: Optional[bool]
    temp: Optional[temperature]
    dewpt: Optional[temperature]
    press: Optional[pressure]
    recent: List[Tuple[str, str, str, str, str]]
    runway: List[list]
    runway_tendencies: List[Optional[Literal["U", "D", "N"]]]
    windshear: List[str]
    snowdepth: Optional[distance]

    def __init__(self, **kwargs) -> None: ...
    @classmethod
    def from_metar(cls, metar: "Metar") -> "Conditions": ...
    def copy(self) -> "Conditions": ...
    def as_dict(self) -> dict: ...
    def to_dict(self) -> dict: ...
    def wind(self) -> dict: ...
    def __getitem__(self, key: str) -> object: ...
    def get(self, key: str, default: object = ...) -> object: ...
    def __contains__(self, key: str) -> bool: ...

class TrendSegment:
    kind: str
    indicator: Optional[str]
    start: Optional[datetime]
    end: Optional[datetime]
    effective: Optional[datetime]
    definite: bool
    uncertain: bool
    conditions: Optional[Conditions]
    changes: Optional[dict]
    before: Optional[Conditions]
    after: Optional[Conditions]
    tokens: List[str]
    index: int

    @property
    def type(self) -> str: ...
    @property
    def category(self) -> str: ...
    @property
    def change(self) -> Optional[str]: ...
    @property
    def is_observation(self) -> bool: ...
    @property
    def is_becoming(self) -> bool: ...
    @property
    def is_temporary(self) -> bool: ...
    @property
    def is_permanent(self) -> bool: ...
    @property
    def valid_from(self) -> Optional[datetime]: ...
    @property
    def valid_to(self) -> Optional[datetime]: ...
    @property
    def text(self) -> str: ...
    @property
    def code(self) -> str: ...
    @property
    def midpoint(self) -> Optional[datetime]: ...
    @property
    def duration(self) -> Optional[timedelta]: ...
    def is_established(self, when: datetime) -> bool: ...
    def is_pending(self, when: datetime) -> bool: ...
    def contains(self, when: datetime) -> bool: ...
    def as_dict(self) -> dict: ...

class TrendSegmentList(List[TrendSegment]):
    def __call__(self) -> "TrendSegmentList": ...
    def at(self, when: datetime) -> "TrendSegmentList": ...
    def of_kind(self, kind: str) -> "TrendSegmentList": ...
    @property
    def observations(self) -> "TrendSegmentList": ...
    @property
    def becoming(self) -> "TrendSegmentList": ...
    @property
    def temporary(self) -> "TrendSegmentList": ...
    @property
    def permanent(self) -> "TrendSegmentList": ...

class TrendSnapshot:
    time: datetime
    conditions: Conditions
    prevailing: Conditions
    underlying: Conditions
    uncertain: bool
    possible: List[Conditions]
    possibilities: List[Conditions]
    temporary: List[TrendSegment]
    overlays: List[TrendSegment]
    segments: List[TrendSegment]
    status: str

    @property
    def certain(self) -> bool: ...
    @property
    def is_uncertain(self) -> bool: ...
    @property
    def ambiguous(self) -> bool: ...
    @property
    def certainty(self) -> str: ...
    @property
    def alternatives(self) -> List[Conditions]: ...
    def as_dict(self) -> dict: ...
    def to_dict(self) -> dict: ...
    def __getitem__(self, key: str) -> object: ...
    def get(self, key: str, default: object = ...) -> object: ...
    def __contains__(self, key: str) -> bool: ...

class TrendView:
    metar: "Metar"
    segments: TrendSegmentList
    timeline: TrendSegmentList

    def __call__(self) -> "TrendView": ...
    def __iter__(self): ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> TrendSegment: ...
    def at(self, when: object) -> TrendSnapshot: ...
    def conditions_at(self, when: object) -> TrendSnapshot: ...

